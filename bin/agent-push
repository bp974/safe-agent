#!/bin/bash

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SAFE_AGENT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
AGENT_ROOT="$SAFE_AGENT/work"
CONFIG_FILE="$SAFE_AGENT/.env"

# Load user-specific configuration.
if [ -f "$CONFIG_FILE" ]; then
    set -a
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
    set +a
fi

if [ -z "${REAL_PROJECT_ROOT:-}" ]; then
    echo "ERROR: REAL_PROJECT_ROOT is not configured."
    echo
    echo "Copy .env.example to .env and configure:"
    echo "  REAL_PROJECT_ROOT"
    exit 1
fi

REAL_ROOT="$REAL_PROJECT_ROOT"

CURRENT_DIR="$(pwd -P)"

# Must run from a project inside the safe agent workspace.
case "$CURRENT_DIR" in
    "$AGENT_ROOT"/*)
        ;;
    *)
        echo "ERROR: Run agent-push from a project inside:"
        echo "  $AGENT_ROOT/"
        exit 1
        ;;
esac

PROJECT="$(basename "$CURRENT_DIR")"
REAL_PROJECT="$REAL_ROOT/$PROJECT"

if [ ! -d "$CURRENT_DIR/.git" ]; then
    echo "ERROR: Current directory is not a Git repository."
    exit 1
fi

if [ ! -d "$REAL_PROJECT/.git" ]; then
    echo "ERROR: Matching real repository not found:"
    echo "  $REAL_PROJECT"
    exit 1
fi

# Safe agent workspace must be clean.
if [ -n "$(git -C "$CURRENT_DIR" status --porcelain)" ]; then
    echo "ERROR: Safe agent workspace has uncommitted changes."
    echo "Commit or discard them before pushing."
    exit 1
fi

# Real workspace must be clean.
if [ -n "$(git -C "$REAL_PROJECT" status --porcelain)" ]; then
    echo "ERROR: Real repository has uncommitted changes."
    echo
    git -C "$REAL_PROJECT" status --short
    echo
    echo "Commit or stash them before pushing."
    exit 1
fi

echo "Checking committed agent work:"
echo
echo "  $CURRENT_DIR"
echo "       ↓"
echo "  $REAL_PROJECT"
echo

# Fetch the safe workspace HEAD into the real repository.
git -C "$REAL_PROJECT" fetch "$CURRENT_DIR" HEAD

# Capture the exact fetched commit.
AGENT_COMMIT="$(git -C "$REAL_PROJECT" rev-parse FETCH_HEAD)"
REAL_HEAD="$(git -C "$REAL_PROJECT" rev-parse HEAD)"

# Already identical?
if [ "$AGENT_COMMIT" = "$REAL_HEAD" ]; then
    echo "Nothing to push."
    exit 0
fi

# Require real HEAD to be an ancestor of the agent commit.
# This guarantees the push can be performed as a clean fast-forward.
if ! git -C "$REAL_PROJECT" merge-base --is-ancestor \
    "$REAL_HEAD" "$AGENT_COMMIT"; then

    echo "ERROR: Real and safe agent repositories have diverged."
    echo
    echo "Push aborted. Run agent-pull or reconcile the histories manually."
    exit 1
fi

echo "Commits to push:"
echo

git -C "$REAL_PROJECT" --no-pager log \
    --oneline \
    "$REAL_HEAD..$AGENT_COMMIT"

echo
echo "Files changed:"
echo

git -C "$REAL_PROJECT" --no-pager diff \
    --name-status \
    "$REAL_HEAD" \
    "$AGENT_COMMIT"

echo
echo "Change summary:"
echo

git -C "$REAL_PROJECT" --no-pager diff \
    --stat \
    "$REAL_HEAD" \
    "$AGENT_COMMIT"

echo
echo "This will modify your REAL working copy:"
echo "  $REAL_PROJECT"
echo

read -r -p "Continue with push? [y/N] " RESPONSE

case "$RESPONSE" in
    y|Y|yes|YES|Yes)
        ;;
    *)
        echo "Push cancelled."
        exit 0
        ;;
esac

echo

git -C "$REAL_PROJECT" merge \
    --ff-only \
    "$AGENT_COMMIT"

echo
echo "Push complete."
echo
echo "Real repository status:"
git -C "$REAL_PROJECT" status --short
