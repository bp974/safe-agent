#!/bin/bash

set -e

SAFE_CODEX="$HOME/git/safe-codex"
CODEX_ROOT="$SAFE_CODEX/work"
CODEX_HOME="$SAFE_CODEX/container/home"
#CODEX_ROOT="$HOME/codex-work"
#CODEX_HOME="$HOME/codex-container/home"

CURRENT_DIR="$(pwd -P)"

# Refuse to run anywhere except underneath ~/codex-work.
case "$CURRENT_DIR" in
    "$CODEX_ROOT"/*)
        ;;
    *)
        echo "ERROR: Refusing to start Codex."
        echo
        echo "Current directory:"
        echo "  $CURRENT_DIR"
        echo
        echo "Codex may only run inside:"
        echo "  $CODEX_ROOT/"
        exit 1
        ;;
esac

echo "Codex workspace:"
echo "  $CURRENT_DIR"
echo
echo "Only this directory will be mounted into the container."
echo

docker run --rm -it \
    --mount type=bind,source="$CODEX_HOME",target=/root/.codex \
    --mount type=bind,source="$CURRENT_DIR",target=/workspace \
    --workdir /workspace \
    codex-dev \
    codex
