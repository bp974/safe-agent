#!/bin/bash

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SAFE_AGENT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
AGENT_ROOT="$SAFE_AGENT/work"
AGENT_HOME="$SAFE_AGENT/container/home"
CONFIG_FILE="$SAFE_AGENT/.env"

# Load user-specific configuration.
if [ -f "$CONFIG_FILE" ]; then
    set -a
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
    set +a
fi

# Defaults.
DEFAULT_AGENT="${DEFAULT_AGENT:-codex}"

if [ -z "${GIT_USER_NAME:-}" ] || [ -z "${GIT_USER_EMAIL:-}" ]; then
    echo "ERROR: Git identity is not configured."
    echo
    echo "Copy .env.example to .env and configure:"
    echo "  GIT_USER_NAME"
    echo "  GIT_USER_EMAIL"
    exit 1
fi

CURRENT_DIR="$(pwd -P)"
AGENT="${1:-$DEFAULT_AGENT}"

# Refuse to run anywhere except underneath the safe workspace.
case "$CURRENT_DIR" in
    "$AGENT_ROOT"/*)
        ;;
    *)
        echo "ERROR: Refusing to start agent."
        echo
        echo "Current directory:"
        echo "  $CURRENT_DIR"
        echo
        echo "Agents may only run inside:"
        echo "  $AGENT_ROOT/"
        exit 1
        ;;
esac

# Load optional per-project data-only configuration.
PROJECT_CONFIG="$CURRENT_DIR/.safe-agent.toml"

EXTRA_DOCKER_MOUNTS=()

if [ -f "$PROJECT_CONFIG" ]; then
    CONFIG_OUTPUT=""
    if ! CONFIG_OUTPUT="$(python3 "$SCRIPT_DIR/read-safe-agent-config.py" "$PROJECT_CONFIG")"; then
        exit 1
    fi
    while IFS= read -r mount; do
        [ -n "$mount" ] && EXTRA_DOCKER_MOUNTS+=("$mount")
    done <<< "$CONFIG_OUTPUT"
elif [ -f "$CURRENT_DIR/.safe-agent.conf" ]; then
    echo "ERROR: Found unsupported .safe-agent.conf. Rename it to .safe-agent.toml and convert it to TOML."
    exit 1
fi

EXTRA_DOCKER_ARGS=()

for mount in "${EXTRA_DOCKER_MOUNTS[@]}"; do
    EXTRA_DOCKER_ARGS+=(-v "$mount")
done

SECOND_HOME_MOUNT=""
SECOND_CONTAINER_HOME=""

# Configure the selected agent.
case "$AGENT" in
    codex)
        COMMAND="codex"
        HOME_MOUNT="$AGENT_HOME/codex"
        CONTAINER_HOME="/root/.codex"
        ;;

    claude)
        COMMAND="claude"
        HOME_MOUNT="$AGENT_HOME/claude"
        CONTAINER_HOME="/root/.claude"
        ;;

    opencode)
        COMMAND="opencode"
        HOME_MOUNT="$AGENT_HOME/opencode/config"
        CONTAINER_HOME="/root/.config/opencode"

        SECOND_HOME_MOUNT="$AGENT_HOME/opencode/data"
        SECOND_CONTAINER_HOME="/root/.local/share/opencode"
        ;;

    *)
        echo "ERROR: Unknown agent: $AGENT"
        echo
        echo "Supported agents:"
        echo "  codex"
        echo "  claude"
        echo "  opencode"
        exit 1
        ;;
esac

# Create the agent's persistent configuration directory if needed.
mkdir -p "$HOME_MOUNT"
chmod 700 "$HOME_MOUNT"

if [ -n "$SECOND_HOME_MOUNT" ]; then
    mkdir -p "$SECOND_HOME_MOUNT"
    chmod 700 "$SECOND_HOME_MOUNT"
fi

echo "Agent:"
echo "  $AGENT"
echo
echo "Workspace:"
echo "  $CURRENT_DIR"
echo
echo "Only this workspace and the agent's persistent state"
echo "will be mounted into the container."
echo

EXTRA_MOUNTS=()

if [ -n "$SECOND_HOME_MOUNT" ]; then
    EXTRA_MOUNTS+=(
        --mount "type=bind,source=$SECOND_HOME_MOUNT,target=$SECOND_CONTAINER_HOME"
    )
fi

docker run --rm -it \
    --env GIT_USER_NAME="${GIT_USER_NAME:-}" \
    --env GIT_USER_EMAIL="${GIT_USER_EMAIL:-}" \
    --env CODEX_HOME=/root/.codex \
    --mount type=bind,source="$HOME_MOUNT",target="$CONTAINER_HOME" \
    "${EXTRA_MOUNTS[@]}" \
    "${EXTRA_DOCKER_ARGS[@]}" \
    --mount type=bind,source="$CURRENT_DIR",target=/workspace \
    --workdir /workspace \
    safe-agent \
    bash -c '
        if [ -n "$GIT_USER_NAME" ]; then
            git config --global user.name "$GIT_USER_NAME"
        fi

        if [ -n "$GIT_USER_EMAIL" ]; then
            git config --global user.email "$GIT_USER_EMAIL"
        fi

        exec "$@"
    ' bash "$COMMAND"
