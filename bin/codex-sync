#!/bin/bash

set -e

SAFE_CODEX="$HOME/git/safe-codex"
CODEX_ROOT="$SAFE_CODEX/work"
REAL_ROOT="$HOME/git"
#CODEX_ROOT="$HOME/codex-work"
#REAL_ROOT="$HOME/git"

CURRENT_DIR="$(pwd -P)"

# Must run from a project directly under ~/codex-work.
case "$CURRENT_DIR" in
    "$CODEX_ROOT"/*)
        ;;
    *)
        echo "ERROR: Run codex-sync from a project inside:"
        echo "  $CODEX_ROOT/"
        exit 1
        ;;
esac

PROJECT="$(basename "$CURRENT_DIR")"
REAL_PROJECT="$REAL_ROOT/$PROJECT"

if [ ! -d "$CURRENT_DIR/.git" ]; then
    echo "ERROR: Current directory is not a Git repository."
    exit 1
fi

if [ ! -d "$REAL_PROJECT/.git" ]; then
    echo "ERROR: Matching real repository not found:"
    echo "  $REAL_PROJECT"
    exit 1
fi

# Don't overwrite unfinished Codex work.
if [ -n "$(git -C "$CURRENT_DIR" status --porcelain)" ]; then
    echo "ERROR: Codex workspace has uncommitted changes."
    echo "Commit or discard them before syncing."
    exit 1
fi

echo "Syncing:"
echo "  $REAL_PROJECT"
echo "       ↓"
echo "  $CURRENT_DIR"
echo

git -C "$CURRENT_DIR" fetch "$REAL_PROJECT" HEAD

git -C "$CURRENT_DIR" merge --ff-only FETCH_HEAD

echo
echo "Sync complete."
