#!/bin/bash

set -e

SAFE_CODEX="$HOME/git/safe-codex"
CODEX_ROOT="$SAFE_CODEX/work"
REAL_ROOT="$HOME/git"

CURRENT_DIR="$(pwd -P)"

# Must run from a project inside the safe Codex workspace.
case "$CURRENT_DIR" in
    "$CODEX_ROOT"/*)
        ;;
    *)
        echo "ERROR: Run codex-push from a project inside:"
        echo "  $CODEX_ROOT/"
        exit 1
        ;;
esac

PROJECT="$(basename "$CURRENT_DIR")"
REAL_PROJECT="$REAL_ROOT/$PROJECT"

if [ ! -d "$CURRENT_DIR/.git" ]; then
    echo "ERROR: Current directory is not a Git repository."
    exit 1
fi

if [ ! -d "$REAL_PROJECT/.git" ]; then
    echo "ERROR: Matching real repository not found:"
    echo "  $REAL_PROJECT"
    exit 1
fi

# Codex workspace must be clean.
if [ -n "$(git -C "$CURRENT_DIR" status --porcelain)" ]; then
    echo "ERROR: Codex workspace has uncommitted changes."
    echo "Commit or discard them before pushing."
    exit 1
fi

# Real workspace must be clean.
if [ -n "$(git -C "$REAL_PROJECT" status --porcelain)" ]; then
    echo "ERROR: Real repository has uncommitted changes."
    echo
    git -C "$REAL_PROJECT" status --short
    echo
    echo "Commit or stash them before pushing."
    exit 1
fi

echo "Checking committed Codex work:"
echo
echo "  $CURRENT_DIR"
echo "       ↓"
echo "  $REAL_PROJECT"
echo

# Fetch Codex HEAD into the real repository.
git -C "$REAL_PROJECT" fetch "$CURRENT_DIR" HEAD

# Capture the exact fetched commit.
IMPORT_COMMIT="$(git -C "$REAL_PROJECT" rev-parse FETCH_HEAD)"
REAL_HEAD="$(git -C "$REAL_PROJECT" rev-parse HEAD)"

# Already identical?
if [ "$IMPORT_COMMIT" = "$REAL_HEAD" ]; then
    echo "Nothing to push."
    exit 0
fi

# Require real HEAD to be an ancestor of the Codex commit.
# This guarantees the push can be a clean fast-forward.
if ! git -C "$REAL_PROJECT" merge-base --is-ancestor \
    "$REAL_HEAD" "$IMPORT_COMMIT"; then

    echo "ERROR: Real and Codex repositories have diverged."
    echo
    echo "Push aborted. Run codex-sync or reconcile the histories manually."
    exit 1
fi

echo "Commits to push:"
echo

git -C "$REAL_PROJECT" --no-pager log \
    --oneline \
    "$REAL_HEAD..$IMPORT_COMMIT"

echo
echo "Files changed:"
echo

git -C "$REAL_PROJECT" --no-pager diff \
    --name-status \
    "$REAL_HEAD" \
    "$IMPORT_COMMIT"

echo
echo "Change summary:"
echo

git -C "$REAL_PROJECT" --no-pager diff \
    --stat \
    "$REAL_HEAD" \
    "$IMPORT_COMMIT"

echo
echo "This will modify your REAL working copy:"
echo "  $REAL_PROJECT"
echo

read -r -p "Continue with push? [y/N] " RESPONSE
#
case "$RESPONSE" in
    y|Y|yes|YES|Yes)
        ;;
    *)
        echo "Push cancelled."
        exit 0
        ;;
esac

echo

git -C "$REAL_PROJECT" merge \
    --ff-only \
    "$IMPORT_COMMIT"

echo
echo "Push complete."
echo
echo "Real repository status:"
git -C "$REAL_PROJECT" status --short
